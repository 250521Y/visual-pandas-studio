# Backend: set these in the service environment
VPS_DATA_DIR=./runtime
VPS_MAX_UPLOAD_MB=20
VPS_MAX_ROWS=100000
VPS_MAX_COLUMNS=200
VPS_MAX_DATASETS=12
VPS_MAX_HISTORY=30
VPS_SESSION_TTL_DAYS=30
VPS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Frontend: empty means same-origin /api (recommended behind Nginx)
VITE_API_BASE=
